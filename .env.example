# Variables de build del frontend (se incrustan en el bundle con `pnpm build`).
# Nunca pongas secretos aquí: todo lo que empiece por VITE_ acaba en el JavaScript público.

# URL base de la API. Dev: http://localhost:8000/api  Producción: https://app.giras.pro/api
VITE_API_URL=http://localhost:8000/api

# Client ID de Google OAuth (el de producción es distinto al de desarrollo).
VITE_GOOGLE_CLIENT_ID=
