# Variables de build del frontend (se incrustan en el bundle con `pnpm build`).
# Nunca pongas secretos aquí: todo lo que empiece por VITE_ acaba en el JavaScript público.

# URL base de la API. Dev: http://localhost:8000/api  Producción: https://app.giras.pro/api
VITE_API_URL=http://localhost:8000/api

# Client ID de Google OAuth (el de producción es distinto al de desarrollo).
VITE_GOOGLE_CLIENT_ID=

# Google Sheets (F4): selector de archivos de Google (Picker API). Públicas, no secretas.
# - VITE_GOOGLE_PICKER_API_KEY: clave de API "Giras Picker" restringida por referente HTTP
#   (https://giras.pro/*, http://localhost:5173/*) y solo a la Google Picker API.
# - VITE_GOOGLE_CLOUD_APP_ID: número del proyecto de Google Cloud del cliente OAuth
#   (IAM y administración › Configuración).
# Si falta alguna, la opción "Vincular Google Sheets" no aparece y el resto funciona igual.
VITE_GOOGLE_PICKER_API_KEY=
VITE_GOOGLE_CLOUD_APP_ID=
